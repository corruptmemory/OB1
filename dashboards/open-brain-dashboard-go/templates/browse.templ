package templates

var canonicalTypes = []string{"task", "idea", "observation", "reference", "person_note"}

templ Browse(data BrowseData) {
	@Layout("Browse — Open Brain") {
		<header class="app-header">
			<h1 class="app-title">Open Brain</h1>
			<nav class="app-nav">
				<a href="/">Home</a>
				<a href="/browse">Browse</a>
			</nav>
		</header>
		<main class="app-main">
			<section class="filter-bar">
				<div class="filter-chip-row">
					<a
						class={ "filter-chip", templ.KV("filter-chip--active", data.Filter.Type == "") }
						href={ templ.SafeURL(TypeChipURL(data.Filter, "")) }
					>all</a>
					for _, t := range canonicalTypes {
						<a
							class={ "filter-chip", TypeClass(t), templ.KV("filter-chip--active", data.Filter.Type == t) }
							href={ templ.SafeURL(TypeChipURL(data.Filter, t)) }
						>{ t }</a>
					}
				</div>

				<form class="filter-form" method="get" action="/browse">
					if data.Filter.Type != "" {
						<input type="hidden" name="type" value={ data.Filter.Type }/>
					}
					<label class="filter-field">
						<span class="filter-label">topic</span>
						<input type="text" name="topic" value={ data.Filter.Topic } placeholder="exact match"/>
					</label>
					<label class="filter-field">
						<span class="filter-label">person</span>
						<input type="text" name="person" value={ data.Filter.Person } placeholder="exact match"/>
					</label>
					<label class="filter-field filter-field--wide">
						<span class="filter-label">content</span>
						<input type="text" name="q" value={ data.Filter.Q } placeholder="substring match"/>
					</label>
					<label class="filter-field">
						<span class="filter-label">window</span>
						<select name="days">
							<option value="0" selected?={ data.Filter.Days == 0 }>all time</option>
							<option value="1" selected?={ data.Filter.Days == 1 }>24 hours</option>
							<option value="7" selected?={ data.Filter.Days == 7 }>7 days</option>
							<option value="30" selected?={ data.Filter.Days == 30 }>30 days</option>
						</select>
					</label>
					<button class="filter-submit" type="submit">apply</button>
					if data.Filter.Active() {
						<a class="filter-clear" href="/browse">clear</a>
					}
				</form>
			</section>

			<section class="browse-results">
				<div class="results-header">
					<span class="results-count">
						{ ItoA64(data.Total) }
						if data.Total == 1 {
							thought
						} else {
							thoughts
						}
						if data.Filter.Active() {
							matching
						}
					</span>
					if data.TotalPages > 1 {
						<span class="results-page">page { ItoA(data.Page) } of { ItoA(data.TotalPages) }</span>
					}
				</div>

				if len(data.Results) == 0 {
					<p class="results-empty">
						if data.Filter.Active() {
							no thoughts match the current filters
						} else {
							nothing captured yet
						}
					</p>
				} else {
					<ul class="thought-list">
						for _, t := range data.Results {
							@ThoughtCard(t)
						}
					</ul>
				}

				if data.TotalPages > 1 {
					<nav class="pagination">
						if data.Page > 1 {
							<a class="pagination-link" href={ templ.SafeURL(BrowseURL(data.Filter, data.Page-1)) }>← prev</a>
						} else {
							<span class="pagination-link pagination-link--disabled">← prev</span>
						}
						<span class="pagination-current">page { ItoA(data.Page) } of { ItoA(data.TotalPages) }</span>
						if data.Page < data.TotalPages {
							<a class="pagination-link" href={ templ.SafeURL(BrowseURL(data.Filter, data.Page+1)) }>next →</a>
						} else {
							<span class="pagination-link pagination-link--disabled">next →</span>
						}
					</nav>
				}
			</section>
		</main>
	}
}
