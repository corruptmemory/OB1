package templates

import (
	"fmt"
	"strings"
)

// EditFormData carries both the thought being edited and any form-level
// error text to re-display after a failed POST. Values for content, type,
// topics, and people mirror the ThoughtDetail but can be overridden when
// the handler wants to echo back user input exactly as submitted on a
// validation failure.
type EditFormData struct {
	Thought        ThoughtDetail
	Error          string
	ContentInput   string
	TypeInput      string
	TopicsInput    string
	PeopleInput    string
}

var editableTypes = []string{"observation", "task", "idea", "reference", "person_note"}

// DetailEditV11 is the v1.1 full-page edit form, rendered by the legacy
// /thought/{id}/edit route. Task 14 deletes it when /v15 flips to /.
// The v1.5 in-pane edit form is DetailEdit in detail_pane.templ.
templ DetailEditV11(data EditFormData) {
	@Layout(fmt.Sprintf("Edit #%d — Open Brain", data.Thought.ID)) {
		<header class="app-header">
			<h1 class="app-title">Open Brain</h1>
			<nav class="app-nav">
				<a href="/">Home</a>
				<a href="/browse">Browse</a>
				<a href="/search">Search</a>
			</nav>
		</header>
		<main class="app-main">
			<a class="back-link" href={ templ.SafeURL(fmt.Sprintf("/thought/%d", data.Thought.ID)) }>← cancel, back to view</a>

			<article class="detail">
				<header class="detail-header">
					<div class="detail-meta">
						<span class="detail-id">#{ ItoA64(data.Thought.ID) }</span>
						<span class="detail-edit-mode">editing</span>
					</div>
				</header>

				if data.Error != "" {
					<div class="edit-error">
						<strong>couldn't save:</strong> { data.Error }
					</div>
				}

				<form class="edit-form" method="post" action={ templ.SafeURL(fmt.Sprintf("/thought/%d/edit", data.Thought.ID)) }>
					<label class="edit-field">
						<span class="edit-label">content</span>
						<textarea name="content" rows="12" class="edit-textarea" required>{ data.ContentInput }</textarea>
					</label>

					<div class="edit-row">
						<label class="edit-field">
							<span class="edit-label">type</span>
							<select name="type" class="edit-select">
								for _, t := range editableTypes {
									if t == data.TypeInput {
										<option value={ t } selected>{ t }</option>
									} else {
										<option value={ t }>{ t }</option>
									}
								}
							</select>
						</label>
					</div>

					<label class="edit-field">
						<span class="edit-label">topics <span class="edit-hint">(comma separated)</span></span>
						<input type="text" name="topics" value={ data.TopicsInput } class="edit-input"/>
					</label>

					<label class="edit-field">
						<span class="edit-label">people <span class="edit-hint">(comma separated)</span></span>
						<input type="text" name="people" value={ data.PeopleInput } class="edit-input"/>
					</label>

					<div class="edit-field">
						<span class="edit-label">action items</span>
						<ul id="action-items-list" class="action-items-list">
							for _, item := range data.Thought.ActionItems {
								@ActionItemRow(item)
							}
						</ul>
						<button
							type="button"
							class="action-item-add"
							hx-get="/partials/action-item-row"
							hx-target="#action-items-list"
							hx-swap="beforeend"
						>+ add action item</button>
					</div>

					<div class="edit-actions">
						<button type="submit" class="edit-save">save changes</button>
						<a href={ templ.SafeURL(fmt.Sprintf("/thought/%d", data.Thought.ID)) } class="edit-cancel">cancel</a>
					</div>
				</form>
			</article>
		</main>
	}
}

// RenderableTopics joins a slice for the comma-separated input. Kept in
// this file because it's only used by the edit form.
func RenderableTopics(parts []string) string {
	return strings.Join(parts, ", ")
}
