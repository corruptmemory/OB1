package templates

import "fmt"

// Sidebar renders the v1.5 filter rail: a compose-new button, three
// filter sections (type chips, time window, topic/person lists), and
// a footer with total/week stats plus the theme toggle.
//
// Every filter anchor has both an href and an hx-get. The href targets
// the full shell at / with the filter applied so non-JS users (and
// middle-click-new-tab, right-click-copy-link) get bookmarkable URLs;
// htmx intercepts the click with hx-get to do a partial /partials/list
// swap targeting #list-pane with hx-push-url. Filter changes always
// resetPage so pagination doesn't leak across clicks.
templ Sidebar(sd SidebarData) {
	<div class="sidebar-inner">
		<button class="btn-new"
			hx-get="/partials/compose"
			hx-target="#compose-slot"
			hx-swap="innerHTML"
		>
			+ New thought
		</button>
		<section class="filter-section">
			<h3 class="filter-heading">Type</h3>
			<ul class="chip-list">
				@typeChip("", "All", totalCount(sd.Types), sd.Active)
				for _, tc := range sd.Types {
					@typeChip(tc.Type, tc.Type, tc.Count, sd.Active)
				}
			</ul>
		</section>
		<section class="filter-section">
			<h3 class="filter-heading">Time</h3>
			<ul class="chip-list chip-list--row">
				@daysChip(0, "All", sd.Active)
				@daysChip(7, "7d", sd.Active)
				@daysChip(30, "30d", sd.Active)
				@daysChip(90, "90d", sd.Active)
			</ul>
		</section>
		if len(sd.Topics) > 0 {
			<section class="filter-section">
				<h3 class="filter-heading">Topics</h3>
				<input type="text" class="sidebar-filter-input" placeholder="Filter topics…"
					oninput="obFilterList(this, 'topics-list')" autocomplete="off"/>
				<ul class="filter-list filter-list--scroll" id="topics-list">
					for _, tc := range sd.Topics {
						@topicRow(tc.Topic, tc.Count, sd.Active)
					}
				</ul>
			</section>
		}
		if len(sd.People) > 0 {
			<section class="filter-section">
				<h3 class="filter-heading">People</h3>
				<input type="text" class="sidebar-filter-input" placeholder="Filter people…"
					oninput="obFilterList(this, 'people-list')" autocomplete="off"/>
				<ul class="filter-list filter-list--scroll" id="people-list">
					for _, pc := range sd.People {
						@personRow(pc.Person, pc.Count, sd.Active)
					}
				</ul>
			</section>
		}
		<footer class="sidebar-footer">
			<div class="stats-line">
				{ fmt.Sprintf("%d thoughts · %d this week", sd.Total, sd.WeekCount) }
			</div>
			<div class="footer-actions">
				<button class="btn-icon" onclick="obToggleTheme()" title="Toggle theme">☾</button>
				<button class="btn-icon" title="Settings (coming soon)" disabled>⚙</button>
			</div>
		</footer>
	</div>
}

templ typeChip(value, label string, count int64, active ListFilters) {
	if active.Type == value {
		<li>
			<a class="chip chip--active"
				href={ templ.SafeURL("/?" + filtersToURL(resetPage(clearType(active)))) }
				hx-get={ "/partials/list?" + filtersToURL(resetPage(clearType(active))) }
				hx-target="#list-pane"
				hx-push-url="true"
			>
				{ label } <span class="chip-count">{ fmt.Sprintf("%d", count) }</span>
			</a>
		</li>
	} else {
		<li>
			<a class="chip"
				href={ templ.SafeURL("/?" + filtersToURL(resetPage(withType(active, value)))) }
				hx-get={ "/partials/list?" + filtersToURL(resetPage(withType(active, value))) }
				hx-target="#list-pane"
				hx-push-url="true"
			>
				{ label } <span class="chip-count">{ fmt.Sprintf("%d", count) }</span>
			</a>
		</li>
	}
}

templ daysChip(days int, label string, active ListFilters) {
	if active.Days == days {
		<li>
			<a class="chip chip--active"
				href={ templ.SafeURL("/?" + filtersToURL(resetPage(withDays(active, 0)))) }
				hx-get={ "/partials/list?" + filtersToURL(resetPage(withDays(active, 0))) }
				hx-target="#list-pane"
				hx-push-url="true"
			>{ label }</a>
		</li>
	} else {
		<li>
			<a class="chip"
				href={ templ.SafeURL("/?" + filtersToURL(resetPage(withDays(active, days)))) }
				hx-get={ "/partials/list?" + filtersToURL(resetPage(withDays(active, days))) }
				hx-target="#list-pane"
				hx-push-url="true"
			>{ label }</a>
		</li>
	}
}

templ topicRow(topic string, count int64, active ListFilters) {
	if active.Topic == topic {
		<li>
			<a class="filter-row filter-row--active"
				href={ templ.SafeURL("/?" + filtersToURL(resetPage(withTopic(active, "")))) }
				hx-get={ "/partials/list?" + filtersToURL(resetPage(withTopic(active, ""))) }
				hx-target="#list-pane"
				hx-push-url="true"
			>
				<span class="filter-label">{ topic }</span>
				<span class="filter-count">{ fmt.Sprintf("%d", count) }</span>
			</a>
		</li>
	} else {
		<li>
			<a class="filter-row"
				href={ templ.SafeURL("/?" + filtersToURL(resetPage(withTopic(active, topic)))) }
				hx-get={ "/partials/list?" + filtersToURL(resetPage(withTopic(active, topic))) }
				hx-target="#list-pane"
				hx-push-url="true"
			>
				<span class="filter-label">{ topic }</span>
				<span class="filter-count">{ fmt.Sprintf("%d", count) }</span>
			</a>
		</li>
	}
}

templ personRow(person string, count int64, active ListFilters) {
	if active.Person == person {
		<li>
			<a class="filter-row filter-row--active"
				href={ templ.SafeURL("/?" + filtersToURL(resetPage(withPerson(active, "")))) }
				hx-get={ "/partials/list?" + filtersToURL(resetPage(withPerson(active, ""))) }
				hx-target="#list-pane"
				hx-push-url="true"
			>
				<span class="filter-label">{ person }</span>
				<span class="filter-count">{ fmt.Sprintf("%d", count) }</span>
			</a>
		</li>
	} else {
		<li>
			<a class="filter-row"
				href={ templ.SafeURL("/?" + filtersToURL(resetPage(withPerson(active, person)))) }
				hx-get={ "/partials/list?" + filtersToURL(resetPage(withPerson(active, person))) }
				hx-target="#list-pane"
				hx-push-url="true"
			>
				<span class="filter-label">{ person }</span>
				<span class="filter-count">{ fmt.Sprintf("%d", count) }</span>
			</a>
		</li>
	}
}
