package templates

templ Search(data SearchData) {
	@Layout("Search — Open Brain") {
		<header class="app-header">
			<h1 class="app-title">Open Brain</h1>
			<nav class="app-nav">
				<a href="/">Home</a>
				<a href="/browse">Browse</a>
				<a href="/search">Search</a>
			</nav>
		</header>
		<main class="app-main">
			<section class="search-bar">
				<form class="search-form" method="get" action="/search">
					<input
						type="text"
						name="q"
						value={ data.Query }
						placeholder="search your brain…"
						class="search-input"
						autofocus
					/>
					<input type="hidden" name="mode" value={ data.Mode }/>
					<button type="submit" class="search-submit">search</button>
				</form>

				<div class="search-mode-toggle">
					<a
						class={ "mode-pill", templ.KV("mode-pill--active", data.Mode == "semantic") }
						href={ templ.SafeURL(SearchURL(data.Query, "semantic", 1)) }
					>semantic</a>
					<a
						class={ "mode-pill", templ.KV("mode-pill--active", data.Mode == "text") }
						href={ templ.SafeURL(SearchURL(data.Query, "text", 1)) }
					>text</a>
				</div>
			</section>

			if data.EmbedError != "" {
				<section class="search-error">
					<h3>semantic search unavailable</h3>
					<p>{ data.EmbedError }</p>
					<p>
						<a href={ templ.SafeURL(SearchURL(data.Query, "text", 1)) }>try text mode instead →</a>
					</p>
				</section>
			}

			if data.Query == "" {
				<section class="search-empty">
					<p>enter a query above to search your brain.</p>
					<p class="search-empty-hint">
						<strong>semantic</strong> mode ranks by cosine similarity against mxbai-embed-large embeddings —
						good for conceptual queries like "how to deploy" or "ssh agent problems".
						<br/>
						<strong>text</strong> mode is a plain substring match on content —
						good for finding exact phrases.
					</p>
				</section>
			} else if data.EmbedError == "" {
				<section class="browse-results">
					<div class="results-header">
						<span class="results-count">
							{ ItoA64(data.Total) }
							if data.Total == 1 {
								thought
							} else {
								thoughts
							}
							if data.Mode == "semantic" {
								searchable
							} else {
								matching
							}
						</span>
						if data.TotalPages > 1 {
							<span class="results-page">page { ItoA(data.Page) } of { ItoA(data.TotalPages) }</span>
						}
					</div>

					if len(data.Results) == 0 {
						<p class="results-empty">no results for "{ data.Query }" in { data.Mode } mode</p>
					} else {
						<ul class="thought-list">
							for _, t := range data.Results {
								@ThoughtCard(t)
							}
						</ul>
					}

					if data.TotalPages > 1 {
						<nav class="pagination">
							if data.Page > 1 {
								<a class="pagination-link" href={ templ.SafeURL(SearchURL(data.Query, data.Mode, data.Page-1)) }>← prev</a>
							} else {
								<span class="pagination-link pagination-link--disabled">← prev</span>
							}
							<span class="pagination-current">page { ItoA(data.Page) } of { ItoA(data.TotalPages) }</span>
							if data.Page < data.TotalPages {
								<a class="pagination-link" href={ templ.SafeURL(SearchURL(data.Query, data.Mode, data.Page+1)) }>next →</a>
							} else {
								<span class="pagination-link pagination-link--disabled">next →</span>
							}
						</nav>
					}
				</section>
			}
		</main>
	}
}
