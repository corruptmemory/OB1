package templates

import "fmt"

// ThoughtCard is the shared card component used by the home page's recent
// list and (later) by browse and search. The <li> stays here so callers can
// just loop over ThoughtData values without thinking about markup. The whole
// card content is wrapped in an anchor so clicking anywhere navigates to the
// detail page.
templ ThoughtCard(t ThoughtData) {
	<li class="thought-item">
		<a class="thought-card-link" href={ templ.SafeURL(fmt.Sprintf("/thought/%d", t.ID)) }>
			<div class="thought-meta">
				<span class={ TypeClass(t.Type) }>{ t.Type }</span>
				<time class="thought-time">{ HumanTime(t.CreatedAt) }</time>
			</div>
			<p class="thought-content">{ Truncate(t.Content, 240) }</p>
			if len(t.Topics) > 0 || len(t.People) > 0 {
				<div class="thought-tags">
					for _, topic := range t.Topics {
						<span class="topic-tag">{ topic }</span>
					}
					for _, person := range t.People {
						<span class="person-tag">{ person }</span>
					}
				</div>
			}
		</a>
	</li>
}
