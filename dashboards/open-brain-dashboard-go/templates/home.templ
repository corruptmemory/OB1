package templates

templ Home(data HomeData) {
	@Layout("Open Brain") {
		<header class="app-header">
			<h1 class="app-title">Open Brain</h1>
			<nav class="app-nav">
				<a href="/">Home</a>
			</nav>
		</header>
		<main class="app-main">
			<section class="stats-grid">
				<div class="stat-card stat-card--hero">
					<div class="stat-value">{ ItoA64(data.Total) }</div>
					<div class="stat-label">
						if data.Total == 1 {
							thought captured
						} else {
							thoughts captured
						}
					</div>
					<div class="stat-sub">
						<span class="stat-sub-value">{ ItoA64(data.WeekCount) }</span>
						<span class="stat-sub-label">this week</span>
					</div>
				</div>
				<div class="stat-card">
					<h3 class="stat-heading">by type</h3>
					if len(data.Types) == 0 {
						<p class="stat-empty">no types yet</p>
					} else {
						<ul class="stat-list">
							for _, tc := range data.Types {
								<li class="stat-row">
									<span class={ TypeClass(tc.Type) }>{ tc.Type }</span>
									<span class="stat-count">{ ItoA64(tc.Count) }</span>
								</li>
							}
						</ul>
					}
				</div>
				<div class="stat-card">
					<h3 class="stat-heading">top topics</h3>
					if len(data.Topics) == 0 {
						<p class="stat-empty">no topics yet</p>
					} else {
						<ul class="stat-list">
							for _, tc := range data.Topics {
								<li class="stat-row">
									<span class="topic-name">{ tc.Topic }</span>
									<span class="stat-count">{ ItoA64(tc.Count) }</span>
								</li>
							}
						</ul>
					}
				</div>
			</section>

			<section class="recent">
				<h2 class="section-heading">recent</h2>
				if len(data.Recent) == 0 {
					<p class="recent-empty">nothing captured yet</p>
				} else {
					<ul class="thought-list">
						for _, t := range data.Recent {
							<li class="thought-item">
								<div class="thought-meta">
									<span class={ TypeClass(t.Type) }>{ t.Type }</span>
									<time class="thought-time">{ HumanTime(t.CreatedAt) }</time>
								</div>
								<p class="thought-content">{ Truncate(t.Content, 240) }</p>
								if len(t.Topics) > 0 || len(t.People) > 0 {
									<div class="thought-tags">
										for _, topic := range t.Topics {
											<span class="topic-tag">{ topic }</span>
										}
										for _, person := range t.People {
											<span class="person-tag">{ person }</span>
										}
									</div>
								}
							</li>
						}
					</ul>
				}
			</section>
		</main>
	}
}
