package templates

templ Home(data HomeData) {
	@Layout("Open Brain") {
		<header class="app-header">
			<h1 class="app-title">Open Brain</h1>
			<nav class="app-nav">
				<a href="/">Home</a>
				<a href="/browse">Browse</a>
				<a href="/search">Search</a>
			</nav>
		</header>
		<main class="app-main">
			<details class="capture-disclosure">
				<summary class="capture-summary">+ capture a thought</summary>
				<form class="capture-form" method="post" action="/capture">
					<label class="edit-field">
						<span class="edit-label">content</span>
						<textarea name="content" rows="6" class="edit-textarea" required placeholder="what's on your mind?"></textarea>
					</label>

					<div class="capture-meta-row">
						<label class="edit-field">
							<span class="edit-label">type</span>
							<select name="type" class="edit-select">
								<option value="observation" selected>observation</option>
								<option value="task">task</option>
								<option value="idea">idea</option>
								<option value="reference">reference</option>
								<option value="person_note">person_note</option>
							</select>
						</label>
						<label class="edit-field capture-field--wide">
							<span class="edit-label">topics <span class="edit-hint">(comma separated)</span></span>
							<input type="text" name="topics" class="edit-input"/>
						</label>
						<label class="edit-field capture-field--wide">
							<span class="edit-label">people <span class="edit-hint">(comma separated)</span></span>
							<input type="text" name="people" class="edit-input"/>
						</label>
					</div>

					<div class="edit-actions">
						<button type="submit" class="edit-save">capture</button>
					</div>
				</form>
			</details>

			<section class="stats-grid">
				<div class="stat-card stat-card--hero">
					<div class="stat-value">{ ItoA64(data.Total) }</div>
					<div class="stat-label">
						if data.Total == 1 {
							thought captured
						} else {
							thoughts captured
						}
					</div>
					<div class="stat-sub">
						<span class="stat-sub-value">{ ItoA64(data.WeekCount) }</span>
						<span class="stat-sub-label">this week</span>
					</div>
				</div>
				<div class="stat-card">
					<h3 class="stat-heading">by type</h3>
					if len(data.Types) == 0 {
						<p class="stat-empty">no types yet</p>
					} else {
						<ul class="stat-list">
							for _, tc := range data.Types {
								<li class="stat-row">
									<span class={ TypeClass(tc.Type) }>{ tc.Type }</span>
									<span class="stat-count">{ ItoA64(tc.Count) }</span>
								</li>
							}
						</ul>
					}
				</div>
				<div class="stat-card">
					<h3 class="stat-heading">top topics</h3>
					if len(data.Topics) == 0 {
						<p class="stat-empty">no topics yet</p>
					} else {
						<ul class="stat-list">
							for _, tc := range data.Topics {
								<li class="stat-row">
									<span class="topic-name">{ tc.Topic }</span>
									<span class="stat-count">{ ItoA64(tc.Count) }</span>
								</li>
							}
						</ul>
					}
				</div>
			</section>

			<section class="recent">
				<h2 class="section-heading">recent</h2>
				if len(data.Recent) == 0 {
					<p class="recent-empty">nothing captured yet</p>
				} else {
					<ul class="thought-list">
						for _, t := range data.Recent {
							@ThoughtCard(t)
						}
					</ul>
				}
			</section>
		</main>
	}
}
