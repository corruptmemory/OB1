package templates

import (
	"fmt"
	"net/url"
)

// DetailEmpty is the placeholder rendered into #detail-pane when the
// URL has no ?id=N selector. Terse, no decoration — clicking the
// + New button pops the compose panel into #compose-slot.
templ DetailEmpty() {
	<div class="detail-inner detail-empty">
		<p>Select a thought or create a new one.</p>
		<button class="btn-secondary"
			type="button"
			hx-get="/partials/compose"
			hx-target="#compose-slot"
			hx-swap="innerHTML"
		>+ New thought</button>
	</div>
}

// DetailRead is the readonly view of a single thought rendered into
// the right pane. The current sidebar/list filter set is threaded
// through so the Edit link and the inline topic/person chip links
// round-trip the active filter state back into the URL.
templ DetailRead(d *ThoughtDetail, current ListFilters) {
	<div class="detail-inner">
		<div class="detail-toolbar">
			<a class="btn-primary"
				href={ templ.SafeURL(fmt.Sprintf("/v15?%s&id=%d&mode=edit", filtersToURL(current), d.ID)) }
				hx-get={ fmt.Sprintf("/partials/detail/%d/edit?%s", d.ID, filtersToURL(current)) }
				hx-target="#detail-pane"
				hx-push-url="true"
			>Edit</a>
			<form class="inline-form"
				method="post"
				action={ templ.SafeURL(fmt.Sprintf("/thought/%d/delete", d.ID)) }
				hx-post={ fmt.Sprintf("/thought/%d/delete", d.ID) }
				hx-target="#detail-pane"
				hx-confirm="Delete this thought?"
			>
				<button class="btn-danger" type="submit">Delete</button>
			</form>
		</div>
		<header class="detail-header">
			<span class={ TypeClass(d.Type) }>{ d.Type }</span>
			<span class="detail-time">captured { HumanTime(d.CreatedAt) }</span>
			if d.UpdatedAt != nil {
				<span class="detail-edited">edited { HumanTime(*d.UpdatedAt) }</span>
			}
			<span class="detail-id">#{ fmt.Sprintf("%d", d.ID) }</span>
		</header>
		<div class="detail-content">{ d.Content }</div>
		if len(d.Topics) > 0 {
			<div class="detail-row">
				<span class="detail-label">Topics:</span>
				for _, topic := range d.Topics {
					<a class="inline-tag"
						href={ templ.SafeURL("/v15?topic=" + url.QueryEscape(topic)) }
						hx-get={ "/partials/list?topic=" + url.QueryEscape(topic) }
						hx-target="#list-pane"
						hx-push-url="true"
					>{ topic }</a>
				}
			</div>
		}
		if len(d.People) > 0 {
			<div class="detail-row">
				<span class="detail-label">People:</span>
				for _, person := range d.People {
					<a class="inline-tag"
						href={ templ.SafeURL("/v15?person=" + url.QueryEscape(person)) }
						hx-get={ "/partials/list?person=" + url.QueryEscape(person) }
						hx-target="#list-pane"
						hx-push-url="true"
					>{ "@" + person }</a>
				}
			</div>
		}
		if len(d.ActionItems) > 0 {
			<div class="detail-section">
				<h4 class="detail-section-heading">Action items</h4>
				<ul class="action-items-read">
					for _, ai := range d.ActionItems {
						<li>
							if ai.Priority != "" {
								<span class={ "priority-chip priority-" + ai.Priority }>{ ai.Priority }</span>
							}
							<span>{ ai.Description }</span>
						</li>
					}
				</ul>
			</div>
		}
		if len(d.DatesMentioned) > 0 {
			<div class="detail-row">
				<span class="detail-label">Dates mentioned:</span>
				for _, dt := range d.DatesMentioned {
					<span class="inline-tag">{ dt }</span>
				}
			</div>
		}
		<details class="detail-raw">
			<summary>Raw metadata</summary>
			<pre>{ string(d.RawMetadata) }</pre>
		</details>
	</div>
}

// DetailEdit is the v1.5 in-pane edit form, rendered into #detail-pane
// by /partials/detail/{id}/edit and by the htmx branch of
// POST /thought/{id}/edit on error. Save posts to the same handler,
// which on success returns DetailRead + HX-Trigger: refresh-row-{id}
// so the list row re-fetches itself.
//
// The v1.1 full-page DetailEdit still exists as DetailEditV11 until
// Task 14 deletes it and the non-htmx fallback path. This template
// reuses the existing ActionItemRow from partials.templ and the
// existing .edit-* and .action-item-* CSS classes; it only adds the
// detail-toolbar-compatible header and a form-error banner.
templ DetailEdit(d *ThoughtDetail, current ListFilters, formErr string) {
	<div class="detail-inner">
		<div class="detail-toolbar">
			<span class="detail-edit-mode">editing #{ fmt.Sprintf("%d", d.ID) }</span>
			<div class="toolbar-spacer"></div>
			<a class="btn-secondary"
				href={ templ.SafeURL(fmt.Sprintf("/v15?%s&id=%d", filtersToURL(current), d.ID)) }
				hx-get={ fmt.Sprintf("/partials/detail/%d?%s", d.ID, filtersToURL(current)) }
				hx-target="#detail-pane"
				hx-push-url="true"
			>Cancel</a>
		</div>
		if formErr != "" {
			<div class="edit-error">
				<strong>couldn't save:</strong> { formErr }
			</div>
		}
		<form class="edit-form"
			method="post"
			action={ templ.SafeURL(fmt.Sprintf("/thought/%d/edit", d.ID)) }
			hx-post={ fmt.Sprintf("/thought/%d/edit", d.ID) }
			hx-target="#detail-pane"
			hx-swap="innerHTML"
		>
			<input type="hidden" name="return_filters" value={ filtersToURL(current) }/>
			<label class="edit-field">
				<span class="edit-label">content</span>
				<textarea name="content" rows="12" class="edit-textarea" required>{ d.Content }</textarea>
			</label>
			<div class="edit-row">
				<label class="edit-field">
					<span class="edit-label">type</span>
					<select name="type" class="edit-select">
						@editTypeOption("observation", d.Type)
						@editTypeOption("task", d.Type)
						@editTypeOption("idea", d.Type)
						@editTypeOption("reference", d.Type)
						@editTypeOption("person_note", d.Type)
					</select>
				</label>
			</div>
			<label class="edit-field">
				<span class="edit-label">topics <span class="edit-hint">(comma separated)</span></span>
				<input type="text" name="topics" value={ joinCSV(d.Topics) } class="edit-input"/>
			</label>
			<label class="edit-field">
				<span class="edit-label">people <span class="edit-hint">(comma separated)</span></span>
				<input type="text" name="people" value={ joinCSV(d.People) } class="edit-input"/>
			</label>
			<div class="edit-field">
				<span class="edit-label">action items</span>
				<ul id="action-items-list" class="action-items-list">
					for _, item := range d.ActionItems {
						@ActionItemRow(item)
					}
				</ul>
				<button type="button"
					class="action-item-add"
					hx-get="/partials/action-item-row"
					hx-target="#action-items-list"
					hx-swap="beforeend"
				>+ add action item</button>
			</div>
			<div class="edit-actions">
				<button type="submit" class="edit-save">save</button>
			</div>
		</form>
	</div>
}

// editTypeOption renders a <option> for the edit form's type select,
// marking it selected when it matches the currently-stored type.
templ editTypeOption(value, current string) {
	if value == current {
		<option value={ value } selected>{ value }</option>
	} else {
		<option value={ value }>{ value }</option>
	}
}
