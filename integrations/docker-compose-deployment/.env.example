# Open Brain docker-compose deployment — secrets and config.
#
# HOW TO USE:
#   1. cp .env.example .env
#   2. Fill in the two required secrets below (POSTGRES_PASSWORD, MCP_ACCESS_KEY)
#   3. chmod 600 .env
#   4. docker compose up -d
#
# .env is gitignored. Never commit it.
#
# Generate strong random values with:
#   POSTGRES_PASSWORD=$(openssl rand -base64 32 | tr -d '=+/' | cut -c1-32)
#   MCP_ACCESS_KEY=$(openssl rand -hex 32)

# --- REQUIRED ---

# PostgreSQL password for the 'openbrain' superuser inside the container.
# Must be set. Also used by the MCP server to connect to the database.
POSTGRES_PASSWORD=replace-me-with-a-strong-random-password

# Shared secret that clients must send in the x-brain-key HTTP header to
# use the MCP endpoint. Treat this like an API key — 32+ random bytes.
MCP_ACCESS_KEY=replace-me-with-a-long-random-hex-string

# --- OPTIONAL ---
#
# The compose file has sensible defaults for these. Uncomment only if you
# want to override them (e.g. swap in a smaller/faster model).

# Ollama embedding model. Default: mxbai-embed-large (1024-dim).
# IMPORTANT: if you change this, you must also change vector(1024) in init.sql
# to match the new model's output dimension, AND recreate the thoughts table.
# EMBEDDING_MODEL=mxbai-embed-large

# Ollama chat model for metadata extraction. Default: qwen2.5:3b.
# For faster responses at some quality cost, try:
#   qwen2.5:1.5b   — ~half the latency, small quality drop
#   llama3.2:1b    — fastest, more hallucination risk in JSON mode
# The compose file and README assume qwen2.5:3b; changing this only updates
# the env var the MCP server sends to Ollama's /v1/chat/completions endpoint.
# CHAT_MODEL=qwen2.5:3b
